# Application
APP_NAME=Standards Q&A Assistant
APP_ENV=development
LOG_LEVEL=INFO

# HTTP server
API_HOST=127.0.0.1
API_PORT=8000

# Document processing
CHUNK_TARGET_TOKENS=1000
CHUNK_MAX_TOKENS=1200
CHUNK_OVERLAP_TOKENS=150
TOKENIZER=word
MANIFEST_PATH=data/manifest/documents.json
PROCESSED_DIR=data/processed

# Embeddings and local Qdrant
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DEVICE=cpu
QDRANT_PATH=storage/qdrant
QDRANT_COLLECTION=regulatory_documents
ROHS_CHUNKS_PATH=data/processed/rohs/chunks.jsonl
REACH_CHUNKS_PATH=data/processed/reach/chunks.jsonl

# Guardrails
GUARDRAIL_MAX_QUESTION_LENGTH=2000

# Semantic retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.35
RETRIEVAL_DENSE_DEPTH=20
RETRIEVAL_SPARSE_DEPTH=20
RETRIEVAL_RRF_K=60
BM25_K1=1.5
BM25_B=0.75
BM25_INDEX_PATH=storage/bm25/index.json

# Answer generation. Leave the key empty in source control.
# Set GROQ_MODEL to a chat model that your Groq account can call.
# The application reports an error if that model is unavailable. It does not substitute another model.
# GROQ_TEMPERATURE defaults to 0 so repeated runs stay stable.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TEMPERATURE=0

# RAGAS judge. This model is separate from GROQ_MODEL and is not substituted
# when it is empty or unavailable. The evaluator reuses GROQ_API_KEY.
# Answer relevancy also uses the local embedding model below. It does not call Groq for embeddings.
RAGAS_EVALUATOR_MODEL=
RAGAS_EVALUATOR_TEMPERATURE=0
RAGAS_EVALUATOR_MAX_TOKENS=2048
RAGAS_ANSWER_RELEVANCY_STRICTNESS=2
RAGAS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAGAS_MAX_RETRIES=3
# Optional: comma-separated question ids to score on resume (pipeline unchanged).
# RAGAS_SCORE_IDS=reach-article-5-no-data,reach-article-6-registration
# Optional: skip guardrail report regeneration during a scoring-only resume.
# RAGAS_SKIP_GUARDRAIL_REPORT=1